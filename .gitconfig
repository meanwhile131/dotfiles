[user]
	email = sascherny@gmail.com
	name = Sasha Chernyakov
[alias]
	ncommit = commit -a --allow-empty-message -m \"\"
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[protocol "file"]
	allow = always
[core]
	editor = nvim
	autocrlf = input
[pull]
	rebase = true
[rerere]
	enabled = true
[diff]
	tool = nvimdiff
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[trailer "changeid"]
	key = Change-Id
[color]
	ui = auto
[sendemail]
    smtpServer = smtp.gmail.com
    smtpServerPort = 587
    smtpEncryption = tls
    smtpUser = sashachernyakov111111@gmail.com
	confirm = auto
[credential]
    helper = store
[difftool]
	prompt = false
[pager]
	diff = false
[review "review.lineageos.org"]
	username = meanwhile131
