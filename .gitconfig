[user]
	email = 51206659+meanwhile131@users.noreply.github.com
	name = meanwhile131
[alias]
	ncommit = commit -a --allow-empty-message -m \"\"
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[core]
	editor = code --wait
	quotePath = false
	autocrlf = input
[pull]
	rebase = true
